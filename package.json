{
  "name": "dockkey",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "dev:mobile": "npm run start --workspace @dockkey/mobile",
    "dev:api": "npm run dev --workspace @dockkey/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run test",
    "build:api": "npm run build --workspace @dockkey/api",
    "build:apk:preview": "npm run build:preview --workspace @dockkey/mobile",
    "build:apk:production": "npm run build:production --workspace @dockkey/mobile"
  }
}
