{
  "expo": {
    "name": "DockKey",
    "slug": "dockkey",
    "scheme": "dockkey",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true },
    "android": {
      "package": "com.dockkey.app",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#FFF9E9" }
    },
    "ios": { "bundleIdentifier": "com.dockkey.app" }
  }
}
