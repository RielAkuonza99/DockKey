# DockKey backend (Vercel). Configure these in Vercel Project Settings, never in git.
APP_MODE=central          # central | selfhost (informational)

# --- AM API Service credentials (server-side only) ---
AM_API_KEY=
AM_API_BASE_URL=https://am-api-service.vercel.app
AM_API_TIMEOUT_MS=20000

# --- Production rate limiting (Upstash Redis REST). Required on Vercel. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: comma-separated browser origins allowed by CORS (native app needs none).
DOCKKEY_ALLOWED_ORIGINS=
