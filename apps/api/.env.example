# DockKey backend (Vercel). Configure these in Vercel Project Settings, never in git.
APP_MODE=selfhost          # central | selfhost (informational)

# --- GenCipta credentials (server-side only) ---
GENCIPTA_API_KEY=
# Exact header name + optional prefix that GenCipta expects for the API key.
# NOT published on the public docs page: confirm in the GenCipta dashboard/playground.
GENCIPTA_API_KEY_HEADER=
GENCIPTA_API_KEY_PREFIX=
GENCIPTA_BASE_URL=https://gateway.gencipta.com
GENCIPTA_SEND_PATH=/api/am-generator/send-link
# Verify Email Link endpoint path: NOT published; there is intentionally no default.
GENCIPTA_VERIFY_PATH=
# json | form: confirm against the provider playground.
GENCIPTA_REQUEST_FORMAT=json
GENCIPTA_TIMEOUT_MS=20000

# --- Production rate limiting (Upstash Redis REST). Required on Vercel. ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: comma-separated browser origins allowed by CORS (native app needs none).
DOCKKEY_ALLOWED_ORIGINS=
